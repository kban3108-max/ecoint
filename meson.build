project('ecoint', 'c',
  version: '1.0.0',
  license: 'LGPL-2.1-only',
  meson_version: '>=1.1.0')

cc = meson.get_compiler('c')
libm = cc.find_library('m', required: false)
inc = include_directories('.')
pkg = import('pkgconfig')

library_type = get_option('library_type')

printf = find_program('printf')

header = '''/* Generated by meson - do not edit */
#ifndef @0@
#define @0@

#define ECOINT_OK 0
#define ECOINT_NOTGOOD -1

#include <stdbool.h>

#ifdef __cplusplus
extern "C" {
#endif

double getthres(double K, double M, double P, double Pool);
double getelo(double K, double M, double P, double Pool, double T, double* Tthres);
bool checkthres(double K, double M, double P, double Pool, double* Tthres);
int winnings(double* p_a, double* p_b, double* Pool, double* win, double K, double M, double P, double D, double DC, int MR, int MP, double* Tthres);

#ifdef __cplusplus
}
#endif

#endif
'''

ecoint_h = configure_file(
  output: 'ecoint.h',
  command: [printf, '%s', header.format('ECOINT_H')],
  capture: true)

ecoint_freestanding_h = configure_file(
  output: 'ecoint_freestanding.h',
  command: [printf, '%s', header.format('ECOINT_ANTIOS_H')],
  capture: true)

if library_type == 'static'
  ecoint = static_library('ecoint', 'ecoint.c',
    include_directories: inc,
    dependencies: libm,
    install: true)

  ecoint_freestanding = static_library('ecoint_freestanding', 'ecoint_freestanding.c',
    include_directories: inc,
    c_args: ['-ffreestanding'],
    install: true)

elif library_type == 'dynamic'
  ecoint = shared_library('ecoint', 'ecoint.c',
    include_directories: inc,
    dependencies: libm,
    install: true)

  ecoint_freestanding = shared_library('ecoint_freestanding', 'ecoint_freestanding.c',
    include_directories: inc,
    c_args: ['-ffreestanding'],
    install: true)

else
  ecoint = both_libraries('ecoint', 'ecoint.c',
    include_directories: inc,
    dependencies: libm,
    install: true)

  ecoint_freestanding = both_libraries('ecoint_freestanding', 'ecoint_freestanding.c',
    include_directories: inc,
    c_args: ['-ffreestanding'],
    install: true)
endif

install_headers(ecoint_h, ecoint_freestanding_h)

pkg.generate(ecoint,
  name: 'ecoint',
  description: 'Macroeconomy-like rating system',
  libraries_private: ['-lm'])

pkg.generate(ecoint_freestanding,
  name: 'ecoint_freestanding',
  description: 'Freestanding build of ecoint')

ecoint_dep = declare_dependency(
  link_with: ecoint,
  include_directories: inc,
  dependencies: libm)

ecoint_freestanding_dep = declare_dependency(
  link_with: ecoint_freestanding,
  include_directories: inc)
